<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".Vehicul_spec_ai">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutAnimation="@anim/layout_stagger_ai"
        android:orientation="vertical">

        <!-- Header mov; panoul alb urca peste el -->
        <LinearLayout
            android:id="@+id/header_LL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5B3FD1"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="56dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventar"
                android:textColor="#C9BDF2"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vehicul nou"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Panoul principal: un singur bloc pentru tot formularul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet_ai"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Sectiunea 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar_ai" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Date generale"
                    android:textColor="#2A2438"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/marca_ET"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_ai"
                android:hint="Marca (ex: Dacia)"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#2A2438"
                android:textColorHint="#9A94AD"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/eElectric_CB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="#5B3FD1"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="Este electric"
                android:textColor="#2A2438"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="22dp"
                android:background="#ECE9F5" />

            <!-- Sectiunea 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar_ai" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Motorizare"
                    android:textColor="#2A2438"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cele 3 optiuni intr-o singura pastila -->
            <RadioGroup
                android:id="@+id/combustil_RG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_segment_group_ai"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/benzina_RB"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_ai"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:text="Benzina"
                    android:textColor="@color/segment_text_ai"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/motorina_RB"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_ai"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Motorina"
                    android:textColor="@color/segment_text_ai"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/electricitate_RB"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_ai"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Electricitate"
                    android:textColor="@color/segment_text_ai"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="Culoare"
                android:textColor="#6B6580"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_input_ai"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Spinner
                    android:id="@+id/culoare_SP"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:entries="@array/culori"
                    android:spinnerMode="dropdown" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="22dp"
                android:background="#ECE9F5" />

            <!-- Sectiunea 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar_ai" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Siguranta"
                    android:textColor="#2A2438"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <RatingBar
                android:id="@+id/sigranta_RB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:numStars="5"
                android:progressBackgroundTint="#E3DFF0"
                android:progressTint="#5B3FD1"
                android:secondaryProgressTint="#E3DFF0"
                android:stepSize="1.0" />

            <Switch
                android:id="@+id/inmatriculat_SW"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="Este inmatriculat"
                android:textColor="#2A2438"
                android:textSize="16sp"
                android:thumbTint="@color/switch_thumb_ai"
                android:trackTint="@color/switch_track_ai" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/salveaza_BTN"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_ai"
                android:onClick="salveazaVehicul"
                android:stateListAnimator="@animator/press_scale_ai"
                android:text="Salveaza"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>